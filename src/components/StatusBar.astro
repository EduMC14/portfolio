---
import { PORTFOLIO_CONTENT } from '../lib/content';

const { profile } = PORTFOLIO_CONTENT;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-line bg-panel-2 font-mono text-xs text-muted select-none mt-16">
  <!-- Barra de estado superior con enlaces y diagnóstico -->
  <div class="mx-auto max-w-[1180px] px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-y-2 gap-x-4">
    
    <!-- Lado Izquierdo: Estado de Git & Errores -->
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 text-cyan font-bold bg-panel px-2 py-0.5 border border-line">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 0a1 1 0 0 1 1 1v1.5a.5.5 0 0 0 .5.5H13a2 2 0 0 1 2 2v2a.5.5 0 0 0 .5.5H15a1 1 0 1 1 0 2h-.5a.5.5 0 0 0-.5.5v2a2 2 0 0 1-2 2h-1.5a.5.5 0 0 0-.5.5V15a1 1 0 1 1-2 0v-1.5a.5.5 0 0 0-.5-.5H8a2 2 0 0 1-2-2v-2a.5.5 0 0 0-.5-.5H5a1 1 0 1 1 0-2h.5a.5.5 0 0 0 .5-.5V6a2 2 0 0 1 2-2h1.5a.5.5 0 0 0 .5-.5V1a1 1 0 0 1 1-1z"/>
        </svg>
        <span>main*</span>
      </span>

      <span class="inline-flex items-center gap-1 text-green text-[11px]">
        <span>&bull;</span> 0 errors
      </span>

      <span class="inline-flex items-center gap-1 text-amber text-[11px]">
        <span>&bull;</span> 0 warnings
      </span>
    </div>

    <!-- Centro / Formato del IDE -->
    <div class="hidden md:flex items-center gap-3 text-comment text-[11px]">
      <span>UTF-8</span>
      <span>&bull;</span>
      <span>LF</span>
      <span>&bull;</span>
      <span>JetBrains Mono</span>
      <span>&bull;</span>
      <span class="text-cyan">Astro v4</span>
    </div>

    <!-- Lado Derecho: Redes & Copyright -->
    <div class="flex items-center gap-4 text-xs ml-auto sm:ml-0">
      <a
        href={profile.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink hover:text-cyan transition-colors"
        title="GitHub de Eduardo Mar"
      >
        [GitHub]
      </a>
      <a
        href={profile.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink hover:text-cyan transition-colors"
        title="LinkedIn de Eduardo Mar"
      >
        [LinkedIn]
      </a>
      <a
        href={profile.socials.email}
        class="text-ink hover:text-cyan transition-colors"
        title="Enviar correo a Eduardo Mar"
      >
        [Email]
      </a>
    </div>

  </div>

  <!-- Copyright Sub-bar -->
  <div class="border-t border-line/40 bg-bg/80 py-2 px-4 sm:px-6 text-center text-[11px] text-comment">
    <span>© {currentYear} {profile.name} &bull; Terminal / IDE Theme &bull; Diseñado con accesibilidad y código limpio</span>
  </div>
</footer>
