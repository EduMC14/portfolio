---
import Window from './Window.astro';
import CodeBlock from './CodeBlock.astro';
import { PORTFOLIO_CONTENT } from '../lib/content';

const { skills } = PORTFOLIO_CONTENT;

// Formateamos las líneas con sintaxis HTML para package.json
const jsonLines = [
  '<span class="text-ink">{</span>',
  '  <span class="s-key">"name"</span><span class="text-ink">:</span> <span class="s-str">"eduardo-mar-tech-stack"</span><span class="text-ink">,</span>',
  '  <span class="s-key">"version"</span><span class="text-ink">:</span> <span class="s-str">"2.0.0"</span><span class="text-ink">,</span>',
  '  <span class="s-key">"private"</span><span class="text-ink">:</span> <span class="s-bool">true</span><span class="text-ink">,</span>',
  '  <span class="s-key">"dependencies"</span><span class="text-ink">: {</span>',
  ...Object.entries(skills.dependencies).map(([key, ver], idx, arr) => {
    const isLast = idx === arr.length - 1;
    return `    <span class="s-key">"${key}"</span><span class="text-ink">:</span> <span class="s-str">"${ver}"</span>${isLast ? '' : '<span class="text-ink">,</span>'}`;
  }),
  '  <span class="text-ink">}</span>',
  '<span class="text-ink">}</span>'
];
---

<section id="skills" class="py-10 border-t border-line/40">
  <div class="mb-4 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-comment text-xs font-mono">// 03. Habilidades técnicas</span>
    </div>
    <span class="text-comment text-xs font-mono">{Object.keys(skills.dependencies).length} dependencias principales</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Ventana Izquierda: package.json con números de línea -->
    <div class="lg:col-span-7">
      <Window file="package.json" badge="JSON · npm">
        <CodeBlock lines={jsonLines} />
      </Window>
    </div>

    <!-- Ventana Derecha: Categorías Desglosadas -->
    <div class="lg:col-span-5 space-y-4">
      <Window file="categorias-stack.yml" badge="YAML">
        <div class="font-mono text-xs space-y-4">
          <p class="text-comment">// Desglose por áreas de dominio técnico:</p>
          
          {skills.categories.map((cat) => (
            <div class="space-y-1.5 border-b border-line/40 pb-3 last:border-b-0 last:pb-0">
              <p class="text-cyan font-bold flex items-center gap-1.5">
                <span class="text-comment">&gt;</span>
                <span>{cat.name}:</span>
              </p>
              <div class="flex flex-wrap gap-1.5 pl-3">
                {cat.items.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </Window>

      <!-- Panel de comando rápido -->
      <div class="border border-line bg-panel-2 p-3 font-mono text-xs text-muted flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="s-prompt">$</span>
          <span class="text-ink">npm run build</span>
        </div>
        <span class="text-green">[ready for production]</span>
      </div>
    </div>
  </div>
</section>
