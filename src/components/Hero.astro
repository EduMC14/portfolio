---
import Window from './Window.astro';
import { PORTFOLIO_CONTENT } from '../lib/content';

const { profile } = PORTFOLIO_CONTENT;
---

<section id="home" class="pt-6 sm:pt-10 pb-12 sm:pb-16">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Ventana Principal: Sesión de Terminal (about.ts) -->
    <div class="lg:col-span-7 space-y-6">
      <Window file="about.ts" badge="TypeScript · vim">
        <div class="space-y-4 font-mono text-[13.5px] leading-relaxed">
          <!-- Prompt whoami -->
          <div class="space-y-1">
            <p class="text-comment text-xs">// 01. Sesión activa en terminal</p>
            <p>
              <span class="s-prompt">{profile.user}@{profile.host}</span><span class="text-muted">:</span><span class="text-cyan">{profile.path}</span><span class="s-prompt">$</span>
              <span class="s-cmd font-bold ml-1.5">whoami</span>
            </p>
            <div class="pt-1 pb-2 flex items-baseline flex-wrap">
              <h1 class="wave-name text-ink" id="waveName">{profile.name}</h1>
              <span class="cursor" aria-hidden="true"></span>
            </div>
          </div>

          <!-- Prompt cat perfil.txt -->
          <div class="border-t border-line/60 pt-3 space-y-1.5">
            <p>
              <span class="s-prompt">{profile.user}@{profile.host}</span><span class="text-muted">:</span><span class="text-cyan">{profile.path}</span><span class="s-prompt">$</span>
              <span class="s-cmd font-bold ml-1.5">cat</span> <span class="text-amber">perfil.txt</span>
            </p>
            <div class="bg-panel-2/60 border border-line p-3 text-ink text-xs sm:text-[13px] leading-relaxed">
              <p class="text-cyan font-bold mb-1">
                &gt; {profile.title} <span class="text-comment font-normal">(@ {profile.company})</span>
              </p>
              <p class="text-ink/90">
                {profile.bio}
              </p>
            </div>
          </div>

          <!-- Prompt status & quick stack -->
          <div class="border-t border-line/60 pt-3 space-y-2">
            <p>
              <span class="s-prompt">{profile.user}@{profile.host}</span><span class="text-muted">:</span><span class="text-cyan">{profile.path}</span><span class="s-prompt">$</span>
              <span class="s-cmd font-bold ml-1.5">./quick-actions.sh</span>
            </p>
            <div class="flex flex-wrap gap-2.5 pt-1">
              <a href="#proyectos" class="btn btn--primary">
                <span class="btn__sym">$</span> ./ver-proyectos.sh
              </a>
              <a href="#contacto" class="btn">
                <span class="btn__sym text-green">&gt;</span> ./contactar.sh
              </a>
              <a href={profile.cvUrl} download class="btn" title="Descargar CV en PDF">
                <span class="btn__sym text-amber">↓</span> cat cv.pdf
              </a>
            </div>
          </div>
        </div>
      </Window>
    </div>

    <!-- Columna Lateral: Retrato + Neofetch -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Ventana Retrato -->
      <Window file="retrato.jpg" badge="image/webp · 640x640">
        <div class="relative bg-panel-2 border border-line overflow-hidden aspect-[4/3] flex items-center justify-center group">
          <img
            src={profile.portrait}
            alt="Fotografía de Eduardo Mar"
            class="w-full h-full object-cover object-center filter contrast-105 group-hover:scale-102 transition-transform duration-300"
            onerror="this.style.display='none'; document.getElementById('img-fallback').style.display='flex';"
          />
          <!-- Marcador ASCII de reserva si la imagen no carga -->
          <div
            id="img-fallback"
            class="hidden absolute inset-0 flex-col items-center justify-center p-4 text-center font-mono text-xs text-comment bg-panel-2"
          >
            <pre class="text-cyan text-[10px] leading-none mb-2">
+------------------+
|  [FALTA ARCHIVO] |
|   retrato.jpg    |
+------------------+
            </pre>
            <p>Foto no disponible</p>
          </div>
          <!-- Etiqueta sobrepuesta estilo terminal -->
          <div class="absolute bottom-2 left-2 bg-panel-2/90 border border-line px-2 py-0.5 text-[11px] font-mono text-green flex items-center gap-1.5 backdrop-blur-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-green animate-pulse"></span>
            <span>online // open-to-work</span>
          </div>
        </div>
      </Window>

      <!-- Ventana Neofetch -->
      <Window file="neofetch.sh" badge="sysinfo">
        <div class="font-mono text-xs space-y-1.5 text-muted">
          <div class="flex justify-between border-b border-line/50 pb-1">
            <span class="text-cyan font-semibold">eduardo@dev</span>
            <span class="text-comment">---------</span>
          </div>
          <div class="grid grid-cols-12 gap-1">
            <span class="col-span-4 text-comment">OS:</span>
            <span class="col-span-8 text-ink">Web / Linux Environment</span>
          </div>
          <div class="grid grid-cols-12 gap-1">
            <span class="col-span-4 text-comment">Rol:</span>
            <span class="col-span-8 text-cyan">Full Stack Dev (Backend: PHP & RabbitMQ)</span>
          </div>
          <div class="grid grid-cols-12 gap-1">
            <span class="col-span-4 text-comment">Empresa:</span>
            <span class="col-span-8 text-ink">BITAM® de México</span>
          </div>
          <div class="grid grid-cols-12 gap-1">
            <span class="col-span-4 text-comment">Ubicación:</span>
            <span class="col-span-8 text-amber">{profile.location}</span>
          </div>
          <div class="grid grid-cols-12 gap-1">
            <span class="col-span-4 text-comment">Uptime:</span>
            <span class="col-span-8 text-green">+3 años de experiencia en IT</span>
          </div>
          <div class="grid grid-cols-12 gap-1">
            <span class="col-span-4 text-comment">AI Workflow:</span>
            <span class="col-span-8 text-magenta">Antigravity · Agentic Dev</span>
          </div>
          <div class="grid grid-cols-12 gap-1">
            <span class="col-span-4 text-comment">Estado:</span>
            <span class="col-span-8 text-purple">Disponible para nuevos retos</span>
          </div>
          <!-- Paleta de colores visual en terminal -->
          <div class="pt-2 flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 flex-1 bg-red"></span>
            <span class="h-2.5 flex-1 bg-amber"></span>
            <span class="h-2.5 flex-1 bg-green"></span>
            <span class="h-2.5 flex-1 bg-cyan"></span>
            <span class="h-2.5 flex-1 bg-blue"></span>
            <span class="h-2.5 flex-1 bg-purple"></span>
            <span class="h-2.5 flex-1 bg-magenta"></span>
          </div>
        </div>
      </Window>

    </div>

  </div>

  <!-- Franja de Métricas / Estadísticas Estilo IDE -->
  <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3">
    {profile.stats.map((st) => (
      <div class="border border-line bg-panel p-3.5 hover:border-line-2 transition-colors reveal">
        <p class="text-cyan text-lg sm:text-xl font-bold font-mono tracking-tight">{st.value}</p>
        <p class="text-ink text-xs font-semibold mt-0.5">{st.label}</p>
        <p class="text-comment text-[11px] mt-0.5">{st.desc}</p>
      </div>
    ))}
  </div>
</section>

<script>
  // Ola del nombre interactiva por letras
  const wave = document.getElementById('waveName');
  if (wave) {
    const raw = wave.textContent ?? '';
    wave.textContent = '';
    Array.from(raw).forEach((char, i) => {
      const span = document.createElement('span');
      span.className = 'ch';
      span.style.setProperty('--i', String(i));
      span.textContent = char;
      wave.appendChild(span);
    });
  }
</script>
